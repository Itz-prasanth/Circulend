digraph ER { rankdir=LR; nodesep=0.35; ranksep=0.9; node [shape=plain,fontname="Helvetica",fontsize=10]; edge [fontname="Helvetica",fontsize=9,color="#475569",arrowhead=tee,arrowtail=crow,dir=both];
categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK category_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">name</TD></TR></TABLE>>];
members [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>members</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK member_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">name</TD></TR><TR><TD ALIGN="LEFT" PORT="2">email (UQ)</TD></TR><TR><TD ALIGN="LEFT" PORT="3">role</TD></TR><TR><TD ALIGN="LEFT" PORT="4">max_loans</TD></TR><TR><TD ALIGN="LEFT" PORT="5">active_loans_count*</TD></TR></TABLE>>];
tools [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>tools</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK tool_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK category_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">name (UQ)</TD></TR><TR><TD ALIGN="LEFT" PORT="3">deposit_amount</TD></TR><TR><TD ALIGN="LEFT" PORT="4">max_loan_days</TD></TR></TABLE>>];
tool_units [peripheries=2,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>tool_units</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK unit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK tool_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">unit_no  (UQ with tool_id)</TD></TR><TR><TD ALIGN="LEFT" PORT="3">serial_no (UQ)</TD></TR><TR><TD ALIGN="LEFT" PORT="4">condition_status</TD></TR><TR><TD ALIGN="LEFT" PORT="5">status</TD></TR></TABLE>>];
loans [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>loans</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK loan_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK unit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">FK member_id</TD></TR><TR><TD ALIGN="LEFT" PORT="3">loan_date / due_date</TD></TR><TR><TD ALIGN="LEFT" PORT="4">return_date</TD></TR><TR><TD ALIGN="LEFT" PORT="5">status, late_fee</TD></TR></TABLE>>];
reservations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>reservations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK reservation_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK unit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">FK member_id</TD></TR><TR><TD ALIGN="LEFT" PORT="3">reserved_for_date</TD></TR><TR><TD ALIGN="LEFT" PORT="4">duration_days</TD></TR><TR><TD ALIGN="LEFT" PORT="5">status, expires_at</TD></TR></TABLE>>];
waitlists [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>waitlists</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK waitlist_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK tool_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">FK member_id</TD></TR><TR><TD ALIGN="LEFT" PORT="3">position</TD></TR><TR><TD ALIGN="LEFT" PORT="4">status</TD></TR></TABLE>>];
damage_reports [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>damage_reports</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK report_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK unit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">FK loan_id</TD></TR><TR><TD ALIGN="LEFT" PORT="3">severity</TD></TR><TR><TD ALIGN="LEFT" PORT="4">description</TD></TR></TABLE>>];
deposits [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>deposits</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK deposit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK loan_id (UQ)</TD></TR><TR><TD ALIGN="LEFT" PORT="2">amount</TD></TR><TR><TD ALIGN="LEFT" PORT="3">status</TD></TR></TABLE>>];
kits [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>kits</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK kit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">name (UQ)</TD></TR></TABLE>>];
kit_components [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>kit_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK,FK kit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">PK,FK tool_id</TD></TR></TABLE>>];
notifications [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f2ef"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK notification_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">FK member_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">message, kind</TD></TR><TR><TD ALIGN="LEFT" PORT="3">read</TD></TR></TABLE>>];
audit_log [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef2f7"><TR><TD BGCOLOR="#0f766e"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">PK audit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="1">table_name, row_id</TD></TR><TR><TD ALIGN="LEFT" PORT="2">action</TD></TR><TR><TD ALIGN="LEFT" PORT="3">old_data / new_data</TD></TR></TABLE>>];
tools -> categories [label="N:1"];
tool_units -> tools [label="N:1 (weak)"];
loans -> tool_units [label="N:1"];
loans -> members [label="N:1"];
reservations -> tool_units [label="N:1"];
reservations -> members [label="N:1"];
waitlists -> tools [label="N:1"];
waitlists -> members [label="N:1"];
damage_reports -> tool_units [label="N:1"];
damage_reports -> loans [label="N:1"];
deposits -> loans [label="1:1"];
kit_components -> kits [label="N:1"];
kit_components -> tools [label="N:1"];
notifications -> members [label="N:1"];
}